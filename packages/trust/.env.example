# Monad mainnet (chain 143). Two separate wallets: never reuse one key for both roles.
MONAD_RPC_URL=https://rpc.monad.xyz
# mainnet (default) or testnet. Testnet has free gas: set this to testnet and
# MONAD_RPC_URL to https://testnet-rpc.monad.xyz. The two networks have separate
# registries, so an agent registered on one does not exist on the other.
TRUST_NETWORK=mainnet
AGENT_PRIVATE_KEY=
VALIDATOR_PRIVATE_KEY=

# Where receipts are pinned. Without it a data: URI is used (still verifiable, not on IPFS).
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# The Sandworm API, and a token that can read the notebook (a published one is enough).
SANDWORM_API_URL=http://localhost:8003/api
SANDWORM_TOKEN=

# The finding: which notebook and which cells hold its inputs.
WORKSPACE_ID=
NOTEBOOK_ID=
CELL_IDS=
FINDING=
AGENT_NAME=Sandworm
AGENT_MCP_ENDPOINT=
