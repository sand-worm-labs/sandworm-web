{
  "name": "@sandworm/editor",
  "version": "1.0.0",
  "types": "./types/index.d.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./types/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsc --incremental --watch --preserveWatchOutput",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\": \"commonjs\"}' > dist/cjs/package.json",
    "build": "pnpm run build:esm && pnpm run build:cjs",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@sandworm/types": "workspace:*",
    "date-fns": "^4.1.0",
    "fast-diff": "^1.3.0",
    "ramda": "^0.29.1",
    "react-grid-layout": "^1.4.4",
    "sql-formatter": "^15.4.11",
    "uuid": "^9.0.1",
    "yjs": "^13.6.14",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.1",
    "@types/ramda": "^0.31.1",
    "@types/react-grid-layout": "^1.3.5",
    "@types/uuid": "9.0.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.9.3"
  }
}