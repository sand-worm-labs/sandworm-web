<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{title}}</title>
  <style>

     @import url(https://db.onlinewebfonts.com/c/0c3856a335fdfdb8b0652f7c3d367fdd?family=Moderat-Regular); 
    body {
      margin: 0;
      padding: 0;
       font-family: "Moderat-Regular"; 
      line-height: 1.6;
      background-color: #f0f0f0;
    }

    table {
      border-spacing: 0;
      border-collapse: collapse;
    }

    img {
      border: 0;
      outline: none;
      text-decoration: none;
    }

    /* Wrapper */
    .email-wrapper {
      width: 100%;
      background-color: #f0f0f0;
      padding: 20px 0;
    }

    .email-container {
      max-width: 650px;
      min-width: 650px;
      margin: 0 auto;
      background-color: #f2f5f8;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      margin-bottom: 32px;
    }

    /* ── Navbar ── */
    .email-navbar {
      background-color: #ffffff;
      padding: 14px 24px;
      border-bottom: 1px solid #eeeeee;
      display: flex;
      align-items: center;
    }

    .navbar-inner {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .navbar-logo {
      width: 28px;
      height: 28px;
      display: block;
    }

    .navbar-brand {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.12em;
      color: #111111;
      text-transform: uppercase;
    }

    /* ── Hero banner ── */
    .email-hero {
      position: relative;
      overflow: hidden;
      min-height: 160px;
    }

    .hero-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .hero-text {
      flex: 1;
    }

    .hero-welcome {
      font-size: 13px;
      color: #7c5cfc;
      font-weight: 500;
      margin: 0 0 6px 0;
      letter-spacing: 0.02em;
    }

    .hero-headline {
      font-size: 36px;
      font-weight: 800;
      color: #111111;
      line-height: 1.1;
      margin: 0;
      letter-spacing: -1px;
    }

    .hero-headline span {
      color: #7c5cfc;
    }

    .hero-image {
      width: 650px;
      min-height: 120px;
      height: auto;
      display: block;
      flex-shrink: 0;
    }

    /* ── Body ── */
    .email-body {
      padding: 36px 32px;
      color: #333333; 
    
    }

    .email-body h1 {
      margin: 0 0 16px 0;
      color: #333333;
      font-size: 30px;
      font-weight: 900;
      line-height: 1.2;
      letter-spacing: -0.5px;
    }

    .email-body p {
      margin: 0 0 20px 0;
      color: #333333;
      font-size: 14px;
      line-height: 1.75;
    }

    /* ── Features list ── */
    .features-label {
      font-size: 13px;
      color: #333333;
      font-weight: 500;
      margin: 0 0 12px 0;
    }

    .features-list {
      margin: 0 0 28px 0;
      padding: 0;
      list-style: none;
      counter-reset: features;
    }

    .features-list li {
      counter-increment: features;
      display: flex;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 12px;
      font-size: 13.5px;
      color: #333333;
      line-height: 1.6;
    }

    .features-list li::before {
      content: counter(features) ".";
      font-weight: 700;
      color: #333333;
      font-size: 13px;
      min-width: 18px;
      padding-top: 1px;
    }

    /* ── Info bo#333333
    .info-box {
      background-color: #E8EDF3 ;
      border-left: 4px solid #3C00FF;
      padding: 16px 20px;
      margin: 24px 0;
      border-radius: 6px;
    }

    .info-box p {
      margin: 0;
      font-size: 13px;
      color: #333333;
    }

    /* ── Link fallback ── */
    .link-fallback {
      margin-top: 14px;
      padding-top: 10px;
      border-top: 1px solid #eeeeee;
    }

    .link-fallback p {
      font-size: 12px;
      color: #333333;
      margin: 0 0 6px 0;
    }

    .link-fallback a {
      color: #3C00FF;
      word-break: break-all;
      font-size: 12px;
      text-decoration: none;
    }

    /* ── CTA button ── */
    .button-container {
      text-align: center;
      margin: 28px 0;
    }

    .button {
      display: inline-block;
      padding: 14px 36px;
      background-color: #0f0f0f;
      color: #ffffff !important;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 700;
      font-size: 14px;
      letter-spacing: 0.3px;
    }

    /* ── Contact box ── */
    .contact-box, .hero-box, .help-box {
      background-color:#E8EDF3 ;
      border-radius: 12px;
      padding: 20px 24px;
      margin: 20px 0px 0 0px;
    }

    .hero-box{
      margin-top: 5px;
      background-color: #ffffff;
    }

    .contact-box p {
      margin: 0 0 4px 0;
      font-size: 13px;
      color: #555555;
      line-height: 1.7;
    }

    .contact-box a {
      color: #3C00FF;
      text-decoration: none;
    }

    /* ── Footer ── */
    .email-footer {
      background-color:#E8EDF3 ;
      padding: 24px 32px;
      border-top: 1px solid #eeeeee;
      border-radius: 12px;
      margin: 0 16px 0px 16px;
    }

    .footer-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
    }

    .footer-logo {
      width: 24px;
      height: 24px;
    }

    .footer-social {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .footer-social a {
      display: inline-block;
      text-decoration: none;
    }

    .footer-social img {
      width: 20px;
      height: 20px;
      display: block;
    }

    .footer-links {
      margin-bottom: 10px;
    }

    .footer-links a {
      font-size: 12px;
      color: #3C00FF;
      text-decoration: underline;
      margin-right: 14px;
    }

    .footer-copy {
      font-size: 11px;
      color: #5F8491;
      margin: 0;
    }

    /* ── Responsive ── */
    @media only screen and (max-width: 600px) {
      .email-container {
        width: 100% !important;
        border-radius: 0 !important;
      }

      .hero-headline {
        font-size: 28px !important;
      }

      .hero-image {
        width: 90px !important;
      }

      .email-body {
        padding: 28px 20px !important;
      }

      .email-footer {
        padding: 20px !important;
      }
    }
  </style>
</head>

<body>
  <table class="email-wrapper" width="100%" cellpadding="0" cellspacing="0" role="presentation">
    <tr>
      <td align="center">
        <table class="email-container" width="560" cellpadding="0" cellspacing="0" role="presentation">

          <!-- ── Navbar ── -->
         {{!--  <tr>
            <td class="email-navbar">
              <table cellpadding="0" cellspacing="0" role="presentation">
                <tr>
                  <td>
                    <!-- LOGO: replace src with your absolute URL, e.g. https://yourdomain.com/static/logo.png -->
                    <img class="navbar-logo" src="{{logo_url}}" alt="{{app_name}} logo" width="28" height="28" />
                  </td>
                  <td style="padding-left: 8px;">
                    <span class="navbar-brand">{{app_name}}</span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
 --}}
          <!-- ── Hero banner ── -->
          <tr class="email-hero">
                    <!-- BANNER IMAGE: replace src with your absolute URL -->
                    <img class="hero-image" src="{{banner_url}}" alt="Sandworm illustration" width="130" />
                  
          </tr>

          <!-- ── Body ── -->
          <tr>
            <td class="email-body">
              <div class="hero-box">
     <h1>{{greeting}}</h1>

              <p>{{intro}}</p>

              {{#if features}}
              <p class="features-label">Here's some of our features</p>
              <ol class="features-list">
                {{#each features}}
                <li>{{this}}</li>
                {{/each}}
              </ol>
              {{/if}}
              </div>
         

              <div class="info-box">
                <p><strong>Important:</strong> This verification link will expire in 24 hours for security reasons.</p>
              </div>

              <div class="button-container">
                <a href="{{url}}" class="button">{{actionTitle}}</a>
              </div>
<div class="help-box">
  <div class="link-fallback">
                <p>If the button above doesn't work, copy and paste this link into your browser:</p>
                <a href="{{url}}">{{url}}</a>
              </div>

              <p style="margin-top: 24px; color: #333333; font-size: 13px;">
                If you didn't create an account with {{app_name}}, you can safely ignore this email.
              </p>
</div>
            

              <!-- Contact box -->
              <div class="contact-box">
                <p>
                  If you have any questions, please reach out to us on
                  <a href="{{twitter_url}}">X</a> or
                  <a href="{{telegram_url}}">Telegram</a>.
                  We also appreciate any feedback, please send us a message
                  <a href="mailto:{{support_email}}">{{support_email}}</a>
                </p>
              </div>

              <p style="margin-top: 16px; font-size: 13px; color: #333333;">
                Join us across our social media accounts.
              </p>
            </td>
          </tr>

          <!-- ── Footer ── -->
          <tr>
            <td class="email-footer">
          {{!--     <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
                <tr>
                  <td>
                    <!-- Logo left -->
                    <img class="footer-logo" src="{{logo_url}}" alt="{{app_name}}" width="24" height="24" />
                  </td>
                  <td align="right">
                    <!-- Social icons: replace srcs with your icon URLs -->
                    <table cellpadding="0" cellspacing="0" role="presentation">
                      <tr>
                        <td style="padding-left: 12px;">
                          <a href="{{twitter_url}}">
                            <img src="{{twitter_icon_url}}" alt="X / Twitter" width="20" height="20" />
                          </a>
                        </td>
                        <td style="padding-left: 12px;">
                          <a href="{{linkedin_url}}">
                            <img src="{{linkedin_icon_url}}" alt="LinkedIn" width="20" height="20" />
                          </a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table> --}}

              <div class="footer-links" style="margin-top: 16px;">
                <a href="{{help_center_url}}">Help Center</a>
                <a href="{{unsubscribe_url}}">Unsubscribe</a>
              </div>

              <p class="footer-copy">Copyright &copy;{{year}} {{app_name}}. All rights reserved.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>

</html>