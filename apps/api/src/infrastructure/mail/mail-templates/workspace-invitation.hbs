<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
</head>

<body style="margin:0;font-family:arial">
    <table style="border:0;width:100%">
        <tr style="background:#eeeeee">
            <td style="padding:20px;color:#808080;text-align:center;font-size:40px;font-weight:600">
                {{app_name}}
            </td>
        </tr>
        <tr>
            <td style="padding:20px;color:#808080;font-size:16px;font-weight:100">
                Hi there!<br><br>
                <strong>{{inviterName}}</strong> has invited you to join the workspace
                "<strong>{{workspaceName}}</strong>".<br><br>
                Click the button below to accept the invitation and start collaborating.
            </td>
        </tr>
        <tr>
            <td style="text-align:center;padding:20px">
                <a href="{{url}}"
                    style="display:inline-block;padding:20px 40px;background:#00838f;text-decoration:none;color:#ffffff;border-radius:4px;font-weight:600">{{actionTitle}}</a>
            </td>
        </tr>
        <tr>
            <td style="padding:20px;color:#808080;font-size:14px;font-weight:100;text-align:center">
                This invitation will expire in 7 days.<br>
                If you didn't expect this invitation, you can safely ignore this email.
            </td>
        </tr>
    </table>
</body>

</html>