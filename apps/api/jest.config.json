{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "@swc/jest"
    ],
    "^.+\\.mjs$": [
      "@swc/jest"
    ]
  },
  "transformIgnorePatterns": [
    "/node_modules/.pnpm/(?!(p-queue|p-limit|p-timeout|eventemitter3|yocto-queue)@)"
  ],
  "collectCoverageFrom": [
    "**/*.(t|j)s",
    "!**/*.spec.(t|j)s"
  ],
  "coveragePathIgnorePatterns": [
    "/node_modules/",
    "<rootDir>/main.ts",
    "(.+).module.ts"
  ],
  "coverageDirectory": "../coverage",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@/common(.*)$": "<rootDir>/common$1",
    "^@/core(.*)$": "<rootDir>/core$1",
    "^@/features(.*)$": "<rootDir>/features$1",
    "^@/infrastructure(.*)$": "<rootDir>/infrastructure$1",
    "^@/events(.*)$": "<rootDir>/core/events$1",
    "^@/generated(.*)$": "<rootDir>/generated$1",
    "^@/i18n(.*)$": "<rootDir>/i18n$1",
    "^@/config(.*)$": "<rootDir>/core/config$1",
    "^@/constants(.*)$": "<rootDir>/core/constants$1",
    "^@/filters(.*)$": "<rootDir>/core/filters$1",
    "^@/guards(.*)$": "<rootDir>/core/guards$1",
    "^@/utils(.*)$": "<rootDir>/common/utils$1"
  },
  "setupFiles": [
    "../setup-jest.mjs"
  ],
  "cacheDirectory": "../.jest-cache",
  "testTimeout": 120000
}