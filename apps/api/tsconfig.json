{
  "extends": "@sandworm/typescript-config/nestjs.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist",
    "paths": {
      "@/common/*": [
        "src/common/*"
      ],
      "@/core/*": [
        "src/core/*"
      ],
      "@/features/*": [
        "src/features/*"
      ],
      "@/infrastructure/*": [
        "src/infrastructure/*"
      ],
      "@/events/*": [
        "src/events/*"
      ],
      "@/generated/*": [
        "src/generated/*"
      ],
      "@/i18n/*": [
        "src/i18n/*"
      ],
      // core subfolders
      "@/config/*": [
        "src/core/config/*"
      ],
      "@/constants/*": [
        "src/core/constants/*"
      ],
      "@/filters/*": [
        "src/core/filters/*"
      ],
      "@/guards/*": [
        "src/core/guards/*"
      ]
    }
  }
}