##== Environment
NODE_ENV=development

##== Application
APP_NAME="Sandworm GraphQL"
APP_URL=http://localhost:8003
APP_PORT=8003
APP_DEBUG=false
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
APP_LOG_LEVEL=debug
APP_LOG_SERVICE=console
APP_CORS_ORIGIN=http://localhost:3000,http://example.com

##== API Configuration
API_PREFIX=api
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3000

##== Database
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=25432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=sandworm
DATABASE_SCHEMA=public
DATABASE_LOGGING=true
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
ENVIRONMENT_VARIABLES_ENCRYPTION_KEY=secret

##== Authentication (JWT)
AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=secret_for_refresh
AUTH_REFRESH_TOKEN_EXPIRES_IN=3650d
AUTH_FORGOT_SECRET=secret_for_forgot
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=secret_for_confirm_email
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

##== MCP OAuth (apps/mcp signs in as a real Sandworm user via this app's
##== /oauth/* endpoints). Clients (Claude, Codex, Cursor, ...) register
##== themselves via POST /oauth/register — nothing client-specific here.
# Canonical URI of the apps/mcp server (RFC 8707 `resource`) — must match
# what apps/mcp advertises at its own /.well-known/oauth-protected-resource.
MCP_OAUTH_RESOURCE=http://localhost:6789/mcp
# Shared secret apps/mcp sends to POST /oauth/introspect. Keeps the JWT
# signing secret (AUTH_JWT_SECRET) out of apps/mcp's env entirely.
MCP_OAUTH_INTROSPECT_KEY=secret_for_mcp_introspect

##== Mail
MAIL_HOST=localhost
MAIL_PORT=6025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME=Api
MAIL_CLIENT_PORT=6080

##== Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

##== Github auth
GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_ID=

##== OpenRouter
OPENROUTER_PROVISIONING_KEY=sk-or-v1-your-provisioning-key-here
OPENROUTER_DEFAULT_CAP=10.0
OPENROUTER_LIMIT_RESET=monthly

##== Trino (Sandworm Cloud data source, e.g. Dune's Trino endpoint)
TRINO_HOST=
TRINO_PORT=443
TRINO_CATALOG=
TRINO_SCHEMA=
TRINO_USER=
TRINO_PASSWORD=

##== ETHERSCAN (Etherscan V2 unified multi-chain API, used by the calldata_decoder
##== power tool to resolve function selectors from a contract's real ABI)
ETHERSCAN_API_KEY=

##== LOGDY
LOGDY_ENABLED=false
LOGDY_HOST=localhost
LOGDY_PORT=10800


###== AI Service
AI_SERVICE_URL=http://localhost:8000
AI_HANDSHAKE_TOKEN=secret_for_ai_service
AI_CHAT_STREAM=false
AI_CHAT_TEMPERATURE=0.7
AI_CHAT_MAX_TOKENS=20000

# Audit log. Set AUDIT_ENABLED=false to store nothing; AUDIT_LOG_READS=false keeps writes/denials but skips queries and GETs.
AUDIT_ENABLED=true
AUDIT_LOG_READS=true

# Sandworm Cloud data source (Postgres). Leave HOST empty to disable it.
SANDWORM_CLOUD_DB_HOST=
SANDWORM_CLOUD_DB_PORT=5432
SANDWORM_CLOUD_DB_NAME=postgres
SANDWORM_CLOUD_DB_USER=postgres
SANDWORM_CLOUD_DB_PASSWORD=
