PORT=3100

# --- Payments (Arbitrum MPP) -------------------------------------------------
# arbitrum-sepolia (testnet, default) or arbitrum-one (real USDC).
MPP_NETWORK=arbitrum-sepolia
# Signs/binds payment challenges. Any long random string, e.g. `openssl rand -hex 32`.
MPP_SECRET_KEY=
# Wallet that submits the settlement transaction, so it needs a little ETH for gas.
MPP_SERVER_PRIVATE_KEY=
# Where the USDC goes. Defaults to the wallet above.
MPP_RECIPIENT=
# Price per call in USDC base units (6 decimals): 10000 = $0.01.
QUERY_PRICE=10000
