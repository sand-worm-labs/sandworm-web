PORT=6789

# --- Auth (OAuth 2.1 resource server; authorization server is apps/api) -------
# This endpoint's public URL. Must equal MCP_OAUTH_RESOURCE in apps/api/.env.
MCP_PUBLIC_URL=http://localhost:6789/mcp
# apps/api as clients see it (its issuer), and where this server reaches it directly.
AUTH_SERVER_URL=http://localhost:8081
API_URL=http://localhost:8003
# The web app, used to build notebook links.
WEB_URL=http://localhost:8081
# Must equal MCP_OAUTH_INTROSPECT_KEY in apps/api/.env.
MCP_OAUTH_INTROSPECT_KEY=

# --- Debugging --------------------------------------------------------------
# Saves every tool call (arguments, result, timing) to an "MCP session" chat on
# the notebook it touched. On by default; secret-looking arguments are redacted.
LOG_TOOL_CALLS=true

# --- Queue --------------------------------------------------------------------
# The same Redis as apps/api (its REDIS_URL). Calls to the API wait here for the
# API's worker. Leave it out and they go straight to the API instead.
REDIS_URL=redis://localhost:6379
