{
  "name": "@sandworm/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Sandworm",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "inspect": "pnpm dlx @modelcontextprotocol/inspector"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "ioredis": "5.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.8.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.2"
  }
}
