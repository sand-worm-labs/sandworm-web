# Where the main Sandworm app (apps/web) runs. The terminal links back to it.
# In dev that is the Caddy front door (:8081), not the Next.js port (:3000).
NEXT_PUBLIC_WEB_APP_URL=http://localhost:8081

# Public URL of this app, used for metadata (Open Graph, canonical links).
# In dev that is the Caddy front door (:8082) in front of the dev server on :3002.
NEXT_PUBLIC_TERMINAL_URL=http://localhost:8082

# The API, reached directly from the server (not through Caddy).
INTERNAL_API_URL=http://localhost:8003

# Dev only: skip the sign-in and client-membership gate so every page opens.
# Ignored in production builds. Set to "true" to turn it on.
TERMINAL_DEV_BYPASS_AUTH=false

# The API as the browser reaches it (search). Optional: defaults to this app's origin plus /api.
# NEXT_PUBLIC_API_URL=http://localhost:8003/api
