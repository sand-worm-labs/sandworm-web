---
// src/components/SectionHero.astro
import { Image } from 'astro:assets';
import ChatLaunchInput from './ChatLaunchInput.astro';
---

<section
  class="py-16 pt-12 text-center pb-64 min-h-dvh lg:pt-28 text-white relative "
 
>
<picture class="absolute inset-0 -z-10">
  <source srcset="/img/herobg.webp" type="image/webp" />
  <Image
    src="/img/herobg.webp"
    alt=""
    width={1920}
    height={1080}
    class="w-full h-full object-cover lg:object-cover object-[center_center] lg:scale-100 scale-125"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
</picture>
<div class="z-10 relative h-full">
  <div class="absolute inset-0 opacity-60 transition-all duration-500 ease-out"></div>

  <div class="container mx-auto relative flex flex-col h-full items-center">
    <!-- Hero Text Content -->
    <div class="flex items-center space-x-6 relative lg:pt-[8%] pt-16  lg:mt-8 w-full mb-6">
      <div class="relative lg:py-6 w-full">
        <h1 class="mx-auto leading-[1.3] px-3 lg:px-0 lg:text-[2.9rem] text-3xl  xxl:text-[3.4rem] font-bold text-[#F8F9FA]">
          Deep, clean Blockchain Data Analysis
        </h1>

        <p class="text-[#CDD6E7] lg:font-light font-medium mt-4 mb-3 lg:max-w-140 xl:max-w-180 mx-auto  text-base   xxl:text-lg px-5 ">
          Sandworm gives you deep, clear, and editable data on various
          blockchains, driving your whole team to make better data-based
          decisions.
        </p>
      </div>
    </div>

    <!-- Chat Launch Input  -->
    <div class="lg:w-207.5 w-[95%] lg:mx-auto mb-6 lg:mb-0 order-1 lg:order-2 ">
      <ChatLaunchInput />
    </div>

    <!-- Hero Action Buttons  -->
    <div class="flex gap-x-4 mb-12 order-2 lg:order-1 mt-8 lg:mt-0">
      
        <a href="/waitlist" aria-label="get started on sandworm"
        class="rounded-2xl p-2.5 py-3 h-fit m-0.5  text-black outline-white bg-white px-5 transition-colors duration-200 hover:bg-white/80 border border-white font-medium font-primary lg:text-sm text-sm "
      >
        Get Started
      </a>

      
        <a href="/waitlist" aria-label="try out worm ai"
        class="rounded-2xl p-2.5 py-3 h-fit m-0.5 text-white bg-primary  px-5 font-medium border border-white transition-colors duration-200 hover:bg-primary/80 font-primary lg:text-sm text-sm"
      >
        Explore Worm AI
      </a>
    </div>
  </div>
</div>

  <!-- Trusted by -->
  <div class="absolute bottom-16 w-full text-center px-5 text-white flex flex-col items-center z-10">
    <h2 class="uppercase text-sm font-semibold mb-5 text-[#C5C5C5] font-primary">
      Trusted by
    </h2>
    <div class="flex flex-wrap items-center gap-8">
      <Image
        src="/img/base-logo.svg"
        alt="Base logo"
        width={98}
        height={32}
        class="object-contain transition"
        loading="lazy"
        decoding="async"
      />
      <Image
        src="/img/icn-logo-black.svg"
        alt="ICN Logo"
        width={130}
        height={32}
        class="object-contain transition"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>