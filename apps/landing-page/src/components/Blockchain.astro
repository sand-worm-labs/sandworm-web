---
const blockchains = [
  { src: "/img/eth.svg", alt: "Ethereum", width: 78, height: 78, rotate: -15, marginLeft: "0%", finalBottom: -30, delay: 0 },
  { src: "/img/base.svg", alt: "Base", width: 70, height: 70, rotate: 0, marginLeft: "20%", finalBottom: 30, offset: "5px", delay: 0.4 },
  { src: "/img/polygon.svg", alt: "Polygon", width: 82, height: 82, rotate: 12, marginLeft: "40%", finalBottom: 30, delay: 0.8 },
  { src: "/img/celo.svg", alt: "Celo", width: 80, height: 80, rotate: 10, marginLeft: "60%", finalBottom: -30, delay: 1.2 },
  { src: "/img/op.svg", alt: "Optimism", width: 72, height: 72, rotate: 2, marginLeft: "80%", finalBottom: -30, delay: 1.6 },
  { src: "/img/arbitrum.svg", alt: "Arbitrum", width: 96, height: 96, rotate: -15, marginLeft: "100%", finalBottom: 30, delay: 2 },
];
---

<div class="absolute -left-30 right-0 mx-auto h-37.5 w-212.5 w-[550px] top-[10%]">
  {blockchains.map((chain) => (
    <div
      class="blockchain-card absolute bottom-2.5 flex items-center justify-center h-[64px] w-[64px] lg:h-24 lg:w-24 bg-white lg:rounded-[1.2rem] rounded-[7px] opacity-0"
      style={`margin-left: ${chain.marginLeft}; rotate: ${chain.rotate}deg; --final-bottom: ${chain.finalBottom}px; --delay: ${chain.delay}s;`}
      data-animate
    >
      <img
        src={chain.src}
        alt={chain.alt}
        class="w-[50px] h-[50px] lg:w-auto lg:h-auto"
        width={chain.width}
        height={chain.height}
        style={chain.offset ? `margin-left: ${chain.offset}; margin-top: ${parseInt(chain.offset) / 2}px;` : ""}
        loading="lazy"
        decoding="async"
      />
    </div>
  ))}
</div>

<style>
  @keyframes bounce-in {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    50% {
      transform: translateY(-100px);
      opacity: 1;
    }
    100% {
      transform: translateY(var(--final-bottom));
      opacity: 1;
    }
  }

  .blockchain-card.animate {
    animation: bounce-in 1s ease-in-out forwards;
    animation-delay: var(--delay);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("animate");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.3 }
  );

  document.querySelectorAll("[data-animate]").forEach((el) => {
    observer.observe(el);
  });
</script>