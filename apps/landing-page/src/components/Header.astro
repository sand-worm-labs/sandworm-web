---
import SandwormLogo from "../assets/sandworm.svg"

const navLinks = [
  { name: "Explore", href: "workspace/explore" },
  { name: "Documentation", href: "https://docs.sandwormlabs.xyz", isExternal: true },
  { name: "Blog", href: "https://docs.sandwormlabs.xyz/blog", isExternal: true },
  { name: "About", href: "https://docs.sandwormlabs.xyz/blog", isExternal: true },
];
---

<header class="fixed w-full lg:top-5 top-2 mx-auto left-0 right-0 z-99">
  <div class="lg:w-[85%] w-full px-2 mx-auto rounded-xl">
    <div class="px-3 flex justify-between items-center py-2.5">
      <!-- Logo -->
      <div class="flex items-center z-10">
        <a href="/" class="flex items-center" aria-label="Sandworm Labs">
          <SandwormLogo />
          <span class="ml-3 font-bold lg:text-xl text-base uppercase text-white font-primary">
            Sandworm.
          </span>
          <span class="bg-[#E4EAEC] text-[#3F1814] lg:text-xs px-2 py-0.5 rounded-lg text-[0.6rem] ml-2 font-normal font-primary">
            beta
          </span>
        </a>
      </div>

      <!-- Desktop Nav Links -->
      <nav aria-label="Main navigation">
        <ul class="hidden md:flex ml-10 text-[0.9rem] rounded-full py-2.5 px-8 relative space-x-8 font-body xl:text-base">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                target={link.isExternal ? "_blank" : undefined}
                rel={link.isExternal ? "noopener noreferrer" : undefined}
                aria-label={link.name}
                class="text-[#CDD6E7] font-medium hover:text-primary transition-colors"
              >
              
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Launch App Button -->
      <a 
        class="hidden md:flex py-2.5 bg-primary text-white rounded-2xl px-5.5 text-[0.9rem] font-medium hover:scale-105 transition-transform font-primary"
        href="/workspace"
      >
        Launch App
      </a>

      <!-- Mobile Hamburger -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="md:hidden flex flex-col space-y-1 cursor-pointer z-50 relative"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <div class="hamburger-line w-6 h-0.5 bg-[#F8F9FA] transition-transform duration-300 ease-in-out" />
        <div class="hamburger-line w-6 h-0.5 bg-[#F8F9FA] transition-opacity duration-300 ease-in-out" />
        <div class="hamburger-line w-6 h-0.5 bg-[#F8F9FA] transition-transform duration-300 ease-in-out" />
      </button>
    </div>

    <!-- Mobile Menu Fullscreen Overlay -->
    <div
      id="mobile-menu"
      class="md:hidden fixed inset-0 bg-[#06030C] backdrop-blur-sm opacity-0 invisible transition-all duration-300 ease-in-out"
      style="top: 0;"
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-label="Mobile navigation menu"
    >
  
      <nav 
        class="flex flex-col items-left h-full  pt-20 "
        aria-label="Mobile navigation"
      >
      <div class="flex gap-x-2 mb-12 mt-8 lg:mt-0 mx-4 w-auto ">
      
        <a href="/waitlist" aria-label="get started on sandworm"
        class="rounded-2xl p-2.5 py-3 h-fit m-0.5 inline-block flex-1  text-black outline-white bg-white px-5 transition-colors duration-200 hover:bg-white/80 border border-white font-medium font-primary lg:text-sm text-sm text-center"
      >
        Launch App
      </a>
  
      
        <a href="/waitlist" aria-label="try out worm ai"
        class="rounded-2xl p-2.5 py-3 h-fit m-0.5 inline-block flex-1 text-white bg-primary  px-5 font-medium border border-white transition-colors duration-200 hover:bg-primary/80 font-primary lg:text-sm text-sm text-center"
      >
        Explore 
      </a>
    </div>
        {navLinks.map(link => (
          <a
            href={link.href}
            target={link.isExternal ? "_blank" : undefined}
            rel={link.isExternal ? "noopener noreferrer" : undefined}
            class="text-[#CDD6E7] hover:text-white text-xl transition-colors font-medium mx-8 border-b border-[#CDD6E720] py-8 "
            aria-label={link.name}
            tabindex="-1"
          >
            {link.name}
          </a>
        ))}
    
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const lines = btn?.querySelectorAll(".hamburger-line");
  const menuLinks = menu?.querySelectorAll("a");

  btn?.addEventListener("click", () => {
    const isOpen = menu?.getAttribute("aria-hidden") === "true";
    
    // Toggle menu visibility
    menu?.classList.toggle("opacity-0", !isOpen);
    menu?.classList.toggle("invisible", !isOpen);
    menu?.classList.toggle("opacity-100", isOpen);
    menu?.classList.toggle("visible", isOpen);
    
    // Update ARIA attributes
    menu?.setAttribute("aria-hidden", isOpen ? "false" : "true");
    btn?.setAttribute("aria-expanded", isOpen ? "true" : "false");
    
    // Toggle hamburger animation
    if (lines && lines.length === 3) {
      lines[0].classList.toggle("rotate-45", isOpen);
      lines[0].classList.toggle("translate-y-1.5", isOpen);
      lines[1].classList.toggle("opacity-0", isOpen);
      lines[2].classList.toggle("-rotate-45", isOpen);
      lines[2].classList.toggle("-translate-y-1.5", isOpen);
    }
    
    // Handle focus management
    if (isOpen) {
      document.body.style.overflow = "hidden";
      menuLinks?.forEach(link => link.setAttribute("tabindex", "0"));
      menuLinks?.[0]?.focus();
    } else {
      document.body.style.overflow = "";
      menuLinks?.forEach(link => link.setAttribute("tabindex", "-1"));
      btn?.focus();
    }
  });

  // Close menu on ESC key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu?.getAttribute("aria-hidden") === "false") {
      btn?.click();
    }
  });

  // Close menu when clicking outside
  menu?.addEventListener("click", (e) => {
    if (e.target === menu) {
      btn?.click();
    }
  });
</script>