---
const previewSrcMobile = "/img/preview-mobile.png";
const previewSrcDesktop = "/img/preview.webp";
const bgPlaceholder = "data:image/webp;base64,YOUR_BLUR_PLACEHOLDER";
---

<section
  class="relative w-full lg:py-32 py-16 pt-32 min-h-[80vh]  px-6 flex flex-col items-center text-left overflow-hidden text-white bg-black"
  aria-labelledby="video-preview-heading"
>
  <!-- Background Image -->
  <picture class="absolute inset-0 z-10">
    <source
      srcset="/img/temp2.svg"
      sizes="100vw"
      type="image/svg"
    />
    <img
      src="/img/temp2.svg"
      alt=""
      class="w-full h-full object-cover"
      loading="lazy"
      decoding="async"
    />
  </picture>

  <!-- Video/Image Preview -->
  <div class="max-w-6xl xl:max-w-[45%] xl:w-[45%] w-full relative z-10">
    <div class="relative rounded-2xl shadow-lg overflow-hidden">
      <picture>
        <!-- Desktop image (1024px and up) -->
        <source
          media="(min-width: 1024px)"
          srcset={previewSrcDesktop}
          type="image/webp"
          width="1144"
          height="665"
        />
        
        <!-- Mobile image (below 1024px) -->
        <source
          media="(max-width: 523px)"
          srcset={previewSrcMobile}
          type="image/png"
          width="351"
          height="204"
        />
        
        <!-- Fallback -->
        <img
          src={previewSrcMobile}
          alt="Sandworm platform interface showing blockchain data analytics dashboard"
         width="351"
          height="204"
          class="w-full h-auto lg:min-h-125 object-contain"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>
  </div>

  <!-- Text Content Overlay -->
  <div class="lg:absolute bottom-0 
 lg:px-16 px-0 lg:pt-20 pt-16 z-10 bg-linear-to-b from-transparent to-black/90 backdrop-blur-[0.2rem]   mx-auto w-full pb-24">
 <div class="lg:w-[80%] w-full  mx-auto grid lg:grid-cols-[65%_35%] text-center lg:text-left">
  <div class="overflow-hidden">
    <p class="uppercase font-semibold mb-4 text-[0.9rem] font-primary">
      <span aria-hidden="true">●</span> Easy intelligence
    </p>

    <h2 id="video-preview-heading" class="lg:text-[2.5rem] xl:text-[3.5rem] text-[28px] leading-[1.3] font-body text-[#DFE1E6] font-normal">
      Unlock Clear,<br class="hidden lg:inline" />
      Actionable Data for<br class="hidden lg:inline" />
      Smarter Decisions.
    </h2>
  </div>

  <div class="lg:text-lg text-[15px] font-normal  text-[#DFE1E6] leading-normal max-w-120 mt-5">
    <p class="mb-5 font-body hidden md:block">
      Most analytics tools are built for engineers, complicated, rigid,
      and slow. Sandworm brings simplicity and speed to everyone.
    </p>
    <p class="font-body">
      Whether you're a protocol team, data analyst, or founder, Sandworm
      adapts to how you work not the other way around.
    </p>
    <a
      href="/waitlist"
      class="rounded-2xl p-2.5 h-fit m-0.5 bg-white text-black hover:bg-white/90 hover:scale-105 transition-all px-5 font-medium font-primary inline-block text-sm mt-6 "
    >
      Get Started
    </a>
  </div>
 </div>
   
  </div>
</section>