  const container = document.getElementById('workflow-container');
  const cards = document.getElementById('workflow-cards');
  
  if (container && cards) {
    const cardWidth = 530;
    const gap = 40;
    const totalCards = 4;
    const totalCardsWidth = cardWidth * totalCards + gap * (totalCards - 1);
    const maxScroll = totalCardsWidth - (cardWidth * 2.5);

    function handleScroll() {
      const rect = container.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const containerHeight = container.offsetHeight;
      
      // Calculate scroll progress (0 to 1) based on container position
      const startPoint = windowHeight;
      const endPoint = -containerHeight;
      const totalDistance = startPoint - endPoint;
      const currentPosition = startPoint - rect.top;
      const progress = Math.max(0, Math.min(1, currentPosition / totalDistance));
      
      // Apply transform
      const translateX = -progress * maxScroll;
      cards.style.transform = `translateX(${translateX}px)`;
    }

    // Use passive listener for better scroll performance
