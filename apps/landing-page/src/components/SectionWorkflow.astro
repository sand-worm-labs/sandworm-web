---
// src/components/SectionWorkFlow.astro
const workflowSteps = [
  {
    title: "Create and edit notes",
    description: "Using our powerful AI, create a full notebook, filled with charts, data points...",
    imageUrl: "/img/box-2.png",
  },
  {
    title: "Visualize and store data",
    description: "View, understand, utilize and store the information you got from using our product.",
    imageUrl: "/img/box1.svg",
  },
  {
    title: "Organize and export notebooks",
    description: "You can create any amount of dashboard to store your visualizations...",
    imageUrl: "/img/box3.svg",
  }
];
---

<div class="relative bg-black py-20 overflow-hidden">
  <div class="container mx-auto px-6">
    <h2 class="uppercase mb-5 font-medium text-white text-center text-[15px]">
      <span aria-hidden="true">●</span> How Sandworm works <span aria-hidden="true">●</span>
    </h2>
    <h3 class="text-4xl lg:text-7xl text-[#C7C2FF] mb-12 uppercase leading-tight text-center font-black">
      Get started in 3 easy steps
    </h3>

    <div class="relative group">
      <div 
        id="carousel" 
        class="flex gap-5 overflow-x-auto snap-x snap-mandatory scrollbar-hide pb-10 px-4 md:px-0 md:justify-center"
      >
        {workflowSteps.map((step, index) => (
          <div
            data-index={index}
            class="carousel-item min-w-[85vw] md:min-w-[400px] w-full snap-center bg-custom-black-200 rounded-4xl lg:min-h-[500px] min-h-[450px] gradient-border relative overflow-hidden transition-opacity duration-300 bg-custom-black-200 "
          >
            <div class="h-full inner py-8 px-6  rounded-[31px]">
              <div class="relative z-10">
                <h4 class="mb-2 font-semibold uppercase text-white text-[15px]">
                  {index + 1}. {step.title}
                </h4>
                <p class="text-[#8A919E] text-base leading-relaxed">
                  {step.description}
                </p>
              </div>
              <img
                src={step.imageUrl}
                alt={step.title}
                class="absolute bottom-0 left-0 w-full h-auto object-contain pointer-events-none"
                loading="lazy"
              />
            </div>
          </div>
        ))}
      </div>

      <div class="flex justify-center gap-4 mt-4" role="tablist" aria-label="Steps">
        {workflowSteps.map((_, i) => (
          <button
            data-dot={i}
            class="dot w-3  h-3 rounded-full bg-[#3C0C33] transition-all duration-300"
            aria-label={`Go to step ${i + 1}`}
            role="tab"
          ></button>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  
  /* Active state for dots */
  .dot.active {
    background-color: #fff;
    transform: scale(1.2);
    box-shadow: 0 0 10px rgba(199, 194, 255, 0.5);
  }

 
</style>

<script>
  const carousel = document.getElementById('carousel');
  const dots = document.querySelectorAll('.dot');
  const items = document.querySelectorAll('.carousel-item');

  // 1. Update active dot on scroll using Intersection Observer
  const observerOptions = {
    root: carousel,
    threshold: 0.6 // Card must be 60% visible to trigger
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const index = entry.target.getAttribute('data-index');
        updateDots(parseInt(index));
      }
    });
  }, observerOptions);

  items.forEach((item) => observer.observe(item));

  function updateDots(index) {
    dots.forEach((dot, i) => {
      dot.classList.toggle('active', i === index);
      dot.setAttribute('aria-selected', i === index ? 'true' : 'false');
    });
  }

  // 2. Click dots to scroll
  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      items[i].scrollIntoView({
        behavior: 'smooth',
        block: 'nearest',
        inline: 'center'
      });
    });
  });
</script>