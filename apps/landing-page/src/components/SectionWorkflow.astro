---
// src/components/SectionWorkFlow.astro
/* import { Dots } from './icons/Dots.astro';
 */
const workflowSteps = [
  {
    title: "Create and edit notes",
    description:
      "Using our powerful AI, create a full notebook, filled with charts, data points, information and more, all editable, from the raw SQL, to the visualization type.",
    imageUrl: "/img/box-2.png",
    imageConfig: {
      width: 558,
      height: 488,
      containerClassName: "absolute bottom-0 left-[-0.2rem] w-full min-h-[400px]",
    },
  },
  {
    title: "Visualize and store data",
    description:
      "View, understand, utilize and store the information you got from using our product.",
    imageUrl: "/img/box1.svg",
    imageConfig: {
      width: 558,
      height: 410,
      containerClassName: "absolute bottom-0 min-h-[400px]",
    },
  },
  {
    title: "Organize and export notebooks",
    description:
      "You can create any amount of dashboard to store your visualizations, add texts, photos etc to personalize it. You can then share or export them.",
    imageUrl: "/img/box3.svg",
    imageConfig: {
      width: 558,
      height: 410,
      containerClassName: "absolute bottom-0 min-h-[400px]",
    },
  },
/*   {
    title: "Create and edit notes",
    description:
      "Using our powerful AI, create a full notebook, filled with charts, data points, information and more, all editable, from the raw SQL, to the visualization type.",
    imageUrl: "/img/box2.svg",
    imageConfig: {
      width: 558,
      height: 410,
      containerClassName: "absolute bottom-0",
    },
  }, */
];
---

<div class="relative bg-black">
  <div class="px-6 bg-black pt-6 relative container mx-auto">
    <h2 class="uppercase mb-5 text-sm font-medium mt-5 text-white text-center">
      How Sandworm works
    </h2>
    <h3 class="lg:text-[4.5rem] text-4xl text-[#C7C2FF] mb-4 uppercase leading-[1.3] text-center font-secondary font-black">
      Get started in 3 easy steps
    </h3>

    <div class="flex justify-center mb-16">
    <!--   <Dots /> -->
    </div>

    <!-- Static version for performance testing -->
    <div class="flex justify-center w-full">
      <div id="workflow-container" class="w-full relative py-20">
        <div class="h-150 overflow-x-show  scrollbar-hide">
          <div
            id="workflow-cards"
            class="flex gap-10 pl-17 h-full w-max"
          >
            {workflowSteps.map((step, index) => (
              <div
                class="w-132.5 shrink-0 bg-custom-black-200 rounded-2xl min-h-145 h-full gradient-border relative overflow-hidden"
              >
                <div class="inner h-full py-8 px-6 rounded-2xl">
                  <div class="relative z-10 pb-12">
                    <h4 class="mb-3 font-bold uppercase text-white text-xs">
                      {index + 1}. {step.title}
                    </h4>
                    <p class="text-[#8A919E] mb-6 font-body font-medium text-base">
                      {step.description}
                    </p>
                  </div>

                  <div class={step.imageConfig.containerClassName}>
                    <img
                      src={step.imageUrl}
                      width={step.imageConfig.width}
                      height={step.imageConfig.height}
                      alt={step.title}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Hide scrollbar but keep functionality */
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<!--
  SCROLL ANIMATION - COMMENTED OUT FOR PERFORMANCE TESTING
  Uncomment when ready to add scroll-driven horizontal movement
  
