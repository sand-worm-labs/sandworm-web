<section class="pt-16 px-5 relative min-h-[70vh] bg-black" aria-labelledby="onboard-heading">
    <!-- Background Image -->
    <div class="absolute inset-0 " aria-hidden="true">
      <picture>
     <!--    <source
          srcset="/img/light-bar.avif"
          type="image/avif"
        />
        <source
          srcset="/img/light-bar.webp"
          type="image/webp"
        /> -->
        <img
          src="/img/light-bar.svg"
          alt=""
          class="w-full h-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>
  
    <div class="mt-4 py-32 text-center pt-8 pb-48 container mx-auto relative">
      <div class="rounded-lg lg:w-[80%] mx-auto p-1">
        <div class="lg:py-28 py-20 lg:px-8 px-4 flex flex-col items-center justify-center">
          <h2
            id="onboard-heading"
            class="lg:text-[3.8rem] text-4xl text-white mb-7 uppercase leading-[1.1] font-black lg:max-w-162.5"
          >
            Access onchain data in seconds, not days
          </h2>
  
          <a
            href="/chat"
            class="rounded-2xl p-2.5 h-fit m-0.5 text-black bg-white px-5 font-medium text-sm transition-all duration-200 hover:bg-white/80 hover:scale-105 font-primary"
          >
            Get Started
          </a>
        </div>
      </div>
    </div>
  </section>