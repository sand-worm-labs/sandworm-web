---
import Dots from './icons/Dots.astro';

const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:8081';
---

<!-- Hidden until the featured bounties have loaded from the API. -->
<section
  id="bounties"
  hidden
  data-api={`${appUrl}/api/graphql`}
  class="bg-black text-white py-20 px-4"
  aria-labelledby="bounties-heading"
>
  <div class="container mx-auto max-w-6xl">
    <p class="uppercase mb-5 font-semibold text-center text-[15px] font-primary">
      <span aria-hidden="true">●</span> Bounties <span aria-hidden="true">●</span>
    </p>
    <h2
      id="bounties-heading"
      class="text-[52px] lg:text-7xl text-[#C7C2FF] mb-6 uppercase lg:leading-tight leading-none text-center font-black font-mono"
    >
      Get paid for your analysis
    </h2>
    <div class="flex justify-center mb-6" aria-hidden="true">
      <Dots />
    </div>
    <p class="text-[#8A919E] text-base xl:text-lg leading-relaxed text-center max-w-2xl mx-auto mb-12">
      Sponsors post the onchain questions they want answered. Build the dashboard or the research in a
      Sandworm notebook, submit it, and compete for the reward.
    </p>

    <div class="grid gap-4 lg:grid-cols-3" data-bounty-list></div>

    <template data-bounty-card>
      <article class="rounded-4xl gradient-border">
        <div class="inner rounded-[31px] p-8 h-full flex flex-col">
          <p class="flex flex-wrap gap-2 text-[11px] uppercase font-primary text-[#C7C2FF]">
            <span class="rounded-md bg-primary/20 px-2 py-0.5" data-type></span>
            <span class="rounded-md bg-white/10 px-2 py-0.5 text-[#CDD6E7]" data-sample>Past bounty</span>
          </p>
          <h3 class="mt-4 text-lg font-semibold font-body" data-title></h3>
          <p class="mt-2 text-[#8A919E] font-body" data-sponsor></p>
          <p class="mt-auto pt-6 border-t border-white/10 text-[#CDD6E7] font-body font-medium" data-reward></p>
        </div>
      </article>
    </template>

    <div class="flex justify-center mt-8">
      <a
        href={`${appUrl}/bounties`}
        class="rounded-[16px] p-2 py-2.5 m-0.5 bg-white text-black hover:bg-white/90 hover:scale-105 transition-all px-4 font-medium inline-block text-sm font-primary"
      >
        View all bounties
      </a>
    </div>
  </div>
</section>

<script>
  type Bounty = { title: string; sponsor: string; type: string; reward: string | null; sample: boolean };

  const section = document.getElementById('bounties');
  const list = section?.querySelector('[data-bounty-list]');
  const card = section?.querySelector<HTMLTemplateElement>('template[data-bounty-card]');

  async function loadBounties() {
    if (!section || !list || !card) return;
    const response = await fetch(section.dataset.api!, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query: '{ getBounties(featured: true) { title sponsor type reward sample } }' }),
    });
    const bounties: Bounty[] = (await response.json()).data?.getBounties ?? [];
    if (bounties.length === 0) return;

    for (const bounty of bounties) {
      const node = card.content.cloneNode(true) as DocumentFragment;
      node.querySelector('[data-type]')!.textContent = bounty.type;
      node.querySelector('[data-title]')!.textContent = bounty.title;
      node.querySelector('[data-sponsor]')!.textContent = `Sponsored by ${bounty.sponsor}`;
      node.querySelector('[data-reward]')!.textContent = bounty.reward ?? 'Reward set by sponsor';
      if (!bounty.sample) node.querySelector('[data-sample]')!.remove();
      list.append(node);
    }
    section.hidden = false;
  }

  // The section stays hidden if the API cannot be reached.
  loadBounties().catch(() => {});
</script>
