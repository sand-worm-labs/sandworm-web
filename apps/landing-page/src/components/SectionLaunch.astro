---
import  Star from "../assets/star.svg";
import  CircuitIcon  from "../assets/circuit.svg";
/* import { Dots } from "@/components/Assets/Dots";
 */import  Boxes  from "../assets/boxes.svg";
import BlurBlockchain from "./icons/BlurBlockchain.astro";
import BlurRadar from "./icons/BlurRadar.astro";
import BlurConsole from "./icons/BlurConsole.astro";

---

<section class="lg:py-32 py-16 bg-black text-white mb-32" aria-labelledby="features-heading">
  <div class="container mx-auto px-5 py-16">
    <p class="uppercase mb-5 text-xs font-semibold mt-5 text-center">
      <span aria-hidden="true">●</span> Built to Last <span aria-hidden="true">●</span>
    </p>
    <h2 id="features-heading" class="lg:text-[4.5rem] text-4xl text-[#C7C2FF] mb-4 uppercase font-black leading-[1.3] text-center">
      Built for the future
    </h2>

    <div class="flex justify-center mb-16" aria-hidden="true">
      <Boxes />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 gap-x-7">
      <!-- First Card: Explore -->
      <div class="rounded-4xl gradient-border relative will-change-transform overflow-hidden pb-10">
        <div class="inner w-full h-full p-8 py-6 rounded-4xl">
          <div class="absolute right-0 top-0 left-0 w-full" aria-hidden="true">
            <BlurRadar />
          </div>
          <div class="flex flex-col justify-between z-10 relative">
            <div class="flex flex-col items-center">
              <img
                alt="Radar visualization showing data exploration capabilities"
                class="object-contain"
                src="/img/radar-static.svg"
                width="386"
                height="386"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="mt-6 mb-6">
              <Star />
              <h3 class="uppercase text-sm mb-2.5 font-semibold mt-6">
                <span aria-hidden="true">●</span> Explore
              </h3>
              <p class="text-[#8A919E] font-secondary">
                Our protocol helps teams hit their data goals, whether it's
                checking live balances across wallets, gaining on-chain
                insights into onboarding activities, or comparing activity
                across several blockchains over any time frame.
              </p>
              <a
                class="rounded-xl p-2 m-0.5 bg-white text-black hover:bg-white/90 hover:scale-105 transition-all px-4 font-medium inline-block text-sm mt-5"
                href="/waitlist"
              >
                Launch App
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Second Card: Query the Blockchain -->
      <div class="rounded-4xl gradient-border relative will-change-transform overflow-hidden pb-10">
        <div class="inner w-full h-full p-8 py-6 rounded-4xl">
          <div class="absolute right-0 left-0 top-0" aria-hidden="true">
            <BlurBlockchain className="w-full" />
          </div>
          <div class="flex flex-col justify-between h-full z-10 relative">
            <div class="flex flex-col items-center">
              <img
                alt="Supported blockchain networks including Ethereum, Polygon, and more"
                class="object-contain w-full"
                src="/img/chainimages.svg"
                width="606"
                height="345"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="pb-6">
              <CircuitIcon />
              <h3 class="uppercase text-sm mb-2.5 font-semibold mt-6">
                <span aria-hidden="true">●</span> Query the blockchain
              </h3>
              <p class="text-[#8A919E] font-secondary">
                You can explore over 25+ blockchain networks, comparing data,
                getting information and building a database, all with natural
                language prompts.
              </p>
              <a
                class="rounded-xl p-2 m-0.5 bg-white text-black hover:bg-white/90 hover:scale-105 transition-all px-4 font-medium inline-block text-sm mt-5"
                href="/waitlist"
              >
                Explore Queries
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Third Card: Powerful SQL -->
      <div class="rounded-4xl gradient-border relative will-change-transform overflow-hidden lg:col-span-2 pb-10">
        <div class="inner w-full h-full p-8 py-6 rounded-4xl">
          <div class="absolute right-0 top-0 bottom-0 h-full" aria-hidden="true">
            <BlurConsole />
          </div>
          <div class="grid lg:grid-cols-2 relative">
            <div class="flex flex-col justify-center items-start">
              <Boxes />
              <h3 class="uppercase text-sm mb-2.5 font-semibold mt-6">
                <span aria-hidden="true">●</span> Powerful SQL
              </h3>
              <p class="text-[#8A919E] font-secondary pr-10">
                Go beyond static charts, create and tweak pure SQL data which
                powers your visuals to explore deeper insights, test
                hypotheses, and uncover new trends instantly.
              </p>
              <a
                class="rounded-xl p-2 h-fit m-0.5 bg-white text-black hover:bg-white/90 hover:scale-105 transition-all px-4 font-medium inline-block text-sm mt-5"
                href="/waitlist"
              >
                Launch App
              </a>
            </div>

            <div class="flex flex-col items-end mt-6 w-full mb-6">
              <img
                alt="SQL console interface with syntax highlighting"
                class="object-contain w-full"
                src="/img/console.svg"
                width="576"
                height="345"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>