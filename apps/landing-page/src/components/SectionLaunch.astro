---
import { Image } from 'astro:assets';
import  Star from "../assets/star.svg";
import  CircuitIcon  from "../assets/circuit.svg";
import  Boxes  from "../assets/boxes.svg";
import BlurBlockchain from "./icons/BlurBlockchain.astro";
import BlurRadar from "./icons/BlurRadar.astro";
import BlurConsole from "./icons/BlurConsole.astro";
import Dots from "./icons/Dots.astro";

---

  <section class="lg:py-32 py-16 pt-0 lg:pt-32 bg-black text-white mb-32" aria-labelledby="features-heading">
    <div class="container mx-auto px-5 lg:py-16">
      <p class="uppercase mb-4 text-[15px] font-semibold font-primary mt-5 text-center">
        <span aria-hidden="true">● </span> Built to Last <span aria-hidden="true">●</span>
      </p>
      <h2 id="features-heading" class="lg:text-[4.5rem] text-[56px] text-[#C7C2FF] mb-4 mt-5 uppercase font-black lg:leading-[1.3] leading-none text-center font-mono ">
        Built for the future
      </h2>
  
     
  
      <div class="flex justify-center mb-16" aria-hidden="true">
        <Dots/>
      </div>
  
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 gap-x-7">
        <!-- First Card: Explore -->
        <div class="grid grid-cols-1 gap-6">
          <div class="rounded-4xl gradient-border relative will-change-transform overflow-hidden lg:pb-10">
            <div class="inner w-full h-full p-8 py-6 rounded-4xl lg:pb-0">
              <div class="absolute right-0 top-0 left-0 w-full" aria-hidden="true">
                <BlurRadar />
              </div>
              <div class="flex flex-col lg:justify-between z-10 relative lg:h-auto">
                <div class="flex flex-col items-center">
                  <img
                    alt="Radar visualization showing data exploration capabilities"
                    class="object-contain"
                    src="/img/radar-static.svg"
                    width="386"
                    height="386"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="mt-5 mb-6 hidden lg:block">
                  <Star />
                  <h3 class="uppercase text-sm  mb-2.5 font-semibold mt-6">
                    <span aria-hidden="true">● </span> Explore
                  </h3>
                  <p class="text-[#8A919E] font-secondary xl:text-lg">
                    Our <span class="font-bold">protocol</span> helps teams hit their data goals, whether it's
                    checking live balances across wallets, gaining on-chain
                    insights into onboarding activities, or comparing activity
                    across several blockchains over any time frame.
                  </p>
                  <a
                    class="rounded-[16px]  p-2 m-0.5 py-2.5 bg-white text-black hover:bg-white/90 hover:scale-105 transition-all px-4 font-medium inline-block text-sm mt-5 font-primary"
                    href="/waitlist"
                  >
                    Launch App
                  </a>
                </div>
              </div>
            </div>
          </div>
          <div class="lg:hidden px-2 mt-3">
            <Star />
            <h3 class="uppercase text-[15px] mb-2.5 font-semibold mt-6 font-primary">
              <span aria-hidden="true">● </span> Explore
            </h3>
            <p class="text-[#8A919E] font-secondary xl:text-lg">
              Our <span class="font-bold">protocol</span> helps teams hit their data goals, whether it's
              checking live balances across wallets, gaining on-chain
              insights into onboarding activities, or comparing activity
              across several blockchains over any time frame.
            </p>
            <a
              class="rounded-[16px]  p-2 m-0.5 py-2.5 bg-white text-black hover:bg-white/90 hover:scale-105 transition-all px-4 font-medium inline-block text-sm mt-5 font-primary"
              href="/waitlist"
            >
              Launch App
            </a>
          </div>
        </div>
      
        <!-- Second Card: Query the Blockchain -->
        <div class="grid grid-cols-1 gap-6">
          <div class="rounded-4xl gradient-border relative will-change-transform overflow-hidden lg:pb-10 "> 
            <div class="inner w-full h-full p-8 py-6 rounded-4xl">
              <div class="absolute right-0 left-0 top-0" aria-hidden="true">
                <BlurBlockchain className="w-full" />
              </div>
              <div class="flex flex-col lg:justify-between lg:h-full z-10 relative">
                <div class="flex flex-col items-center">
                  <Image
                    alt="Supported blockchain networks including Ethereum, Polygon, and more"
                    class="object-contain w-full min-h-[14rem]"
                    src="/img/chainimages.svg"
                    width={606}
                    height={345}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="pb-6 hidden lg:block">
                  <CircuitIcon />
                  <h3 class="uppercase text-sm mb-2.5 font-semibold mt-6">
                    <span aria-hidden="true">● </span> Query the blockchain
                  </h3>
                  <p class="text-[#8A919E] font-secondary xl:text-lg">
                    You can explore over 25+ blockchain networks, comparing data,
                    getting information and building a database, all with natural
                    language prompts.
                  </p>
                  <a
                    class="rounded-[16px]  p-2 py-2.5 m-0.5 bg-white text-black hover:bg-white/90 hover:scale-105 transition-all px-4 font-medium inline-block text-sm mt-5 font-primary"
                    href="/waitlist"
                  >
                    Explore Queries
                  </a>
                </div>
              </div>
            </div>
          </div>
          <div class="lg:hidden px-2 mt-3">
            <CircuitIcon />
            <h3 class="uppercase text-[15px] mb-2.5 font-semibold mt-6 font-primary">
              <span aria-hidden="true">● </span> Query the blockchain
            </h3>
            <p class="text-[#8A919E] font-secondary xl:text-lg">
              You can explore over 25+ blockchain networks, comparing data,
              getting information and building a database, all with natural
              language prompts.
            </p>
            <a
              class="rounded-[16px]  p-2 py-2.5 m-0.5 bg-white text-black hover:bg-white/90 hover:scale-105 transition-all px-4 font-medium inline-block text-sm mt-5 font-primary"
              href="/waitlist"
            >
              Explore Queries
            </a>
          </div>
        </div>
      
        <!-- Third Card: Powerful SQL -->
        <div class="grid grid-cols-1 gap-6 lg:col-span-2">
          <div class="rounded-4xl gradient-border relative will-change-transform overflow-hidden lg:pb-10">
            <div class="inner w-full h-full p-8 py-6 rounded-4xl">
              <div class="absolute right-0 top-0 bottom-0 h-full" aria-hidden="true">
                <BlurConsole />
              </div>
              <div class="grid lg:grid-cols-2 relative">
                <div class="flex-col justify-center items-start hidden lg:flex">
                  <Boxes />
                  <h3 class="uppercase text-sm mb-2.5 font-semibold mt-6">
                    <span aria-hidden="true">●</span> Powerful SQL
                  </h3>
                  <p class="text-[#8A919E] font-secondary pr-10 xl:text-lg">
                    Go beyond static charts, create and tweak pure SQL data which
                    powers your visuals to explore deeper insights, test
                    hypotheses, and uncover new trends instantly.
                  </p>
                  <a
                    class="rounded-[16px] py-2.5 p-2 h-fit m-0.5 bg-white text-black hover:bg-white/90 hover:scale-105 transition-all px-4 font-medium inline-block text-sm mt-5 font-primary"
                    href="/waitlist"
                  >
                    Launch App
                  </a>
                </div>
      
                <div class="flex flex-col items-end lg:mt-6 w-full lg:mb-6">
                  <img
                    alt="SQL console interface with syntax highlighting"
                    class="object-contain w-full"
                    src="/img/console.svg"
                    width="576"
                    height="345"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            </div>
          </div>
          <div class="lg:hidden px-2 mt-2">
            <Boxes />
            <h3 class="uppercase text-[15px] mb-2.5 font-semibold mt-6 font-primary">
              <span aria-hidden="true">●</span> Powerful SQL
            </h3>
            <p class="text-[#8A919E] font-secondary xl:text-lg">
              Go beyond static charts, create and tweak pure SQL data which
              powers your visuals to explore deeper insights, test
              hypotheses, and uncover new trends instantly.
            </p>
            <a
              class="rounded-[16px] py-2.5 p-2 h-fit m-0.5 bg-white text-black hover:bg-white/90 hover:scale-105 transition-all px-4 font-medium inline-block text-sm mt-5 font-primary"
              href="/waitlist"
            >
              Launch App
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
