# Every setting the Coolify stack reads, for reference. You don't fill this in:
# `deploy.sh envs <env> --write` makes the real file from your sandworm-*.env
# files, and `--apply` sends it to Coolify. Never commit values.
#
# Leave out a setting you don't use instead of adding it empty: the api gets
# them through env_file, where an empty one arrives as "" rather than unset.
#
# Do NOT set these: the compose file fixes them to the stack's own services.
#   DATABASE_HOST DATABASE_PORT DATABASE_TYPE APP_PORT JUPYTER_HOST JUPYTER_PORT
#   AI_SERVICE_URL NEST_BASE_URL REDIS_URL QDRANT_URL MCP_URL INTERNAL_API_URL PORT NODE_ENV API_URL
#
# NEXT_PUBLIC_* and PUBLIC_* are NOT here: they are baked into the web, terminal
# and landing images at build time, so they are GitHub environment variables
# (see .github/workflows/images.yml and ../README.md).

# ── Stack ────────────────────────────────────────────────────────────────────
# IMAGE_TAG: staging | production
IMAGE_TAG=staging
APP_HOST=app.staging.sandwormlab.xyz
TERMINAL_HOST=terminal.staging.sandwormlab.xyz
MCP_HOST=mcp.staging.sandwormlab.xyz
LANDING_HOST=staging.sandwormlab.xyz
# www.sandwormlab.xyz in production; the same as LANDING_HOST when there's no www record
LANDING_WWW_HOST=staging.sandwormlab.xyz

# ── Postgres (the stack's own database; the api and migrations use these too) ──
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=sandworm
DATABASE_SCHEMA=public
DATABASE_LOGGING=false
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false

# ── Shared ───────────────────────────────────────────────────────────────────
# Optional: Qdrant is only reachable inside the stack. Set one to require it anyway.
QDRANT_API_KEY=
JUPYTER_TOKEN=
AI_HANDSHAKE_TOKEN=
MCP_OAUTH_INTROSPECT_KEY=
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
AUDIT_ENABLED=
AUDIT_LOG_READS=

# ── api (gets the whole env through env_file; set only what it uses) ─────────
APP_NAME=
APP_URL=https://app.staging.sandwormlab.xyz
# Shares the sign-in cookie between app. and terminal.
AUTH_COOKIE_DOMAIN=.staging.sandwormlab.xyz
APP_DEBUG=false
APP_FALLBACK_LANGUAGE=
APP_HEADER_LANGUAGE=
APP_LOG_LEVEL=
APP_LOG_SERVICE=
APP_CORS_ORIGIN=
API_PREFIX=
FRONTEND_DOMAIN=
BACKEND_DOMAIN=
SWAGGER_ENABLED=false
AUTH_JWT_SECRET=
AUTH_JWT_TOKEN_EXPIRES_IN=
AUTH_REFRESH_SECRET=
AUTH_REFRESH_TOKEN_EXPIRES_IN=
AUTH_FORGOT_SECRET=
AUTH_FORGOT_TOKEN_EXPIRES_IN=
AUTH_CONFIRM_EMAIL_SECRET=
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=
MAIL_SECURE=
MAIL_REQUIRE_TLS=
MAIL_DEFAULT_EMAIL=
MAIL_DEFAULT_NAME=
MAIL_CLIENT_PORT=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_SECRET=
ENVIRONMENT_VARIABLES_ENCRYPTION_KEY=
OPENROUTER_PROVISIONING_KEY=
OPENROUTER_DEFAULT_CAP=
OPENROUTER_LIMIT_RESET=
TRINO_HOST=
TRINO_PORT=
TRINO_CATALOG=
TRINO_SCHEMA=
TRINO_USER=
TRINO_PASSWORD=
TRINO_HTTP_SCHEME=
ETHERSCAN_API_KEY=
AI_CHAT_STREAM=
AI_CHAT_TEMPERATURE=
AI_CHAT_MAX_TOKENS=
MCP_OAUTH_RESOURCE=https://mcp.staging.sandwormlab.xyz/mcp
SANDWORM_CLOUD_DB_HOST=
SANDWORM_CLOUD_DB_PORT=
SANDWORM_CLOUD_DB_NAME=
SANDWORM_CLOUD_DB_USER=
SANDWORM_CLOUD_DB_PASSWORD=
SHOWCASE_OFFICIAL_WORKSPACE_IDS=
SHOWCASE_STUDIO_PASSWORD=
TRUST_AGENT_PRIVATE_KEY=
TRUST_VALIDATOR_PRIVATE_KEY=
TRUST_AGENT_ID=
TRUST_VALIDATORS=
TRUST_NETWORK=
PINATA_JWT=
IPFS_GATEWAY=
MONAD_RPC_URL=
BOUNTY_REQUIRE_TRUST=

# ── web (runtime only) ───────────────────────────────────────────────────────
REDIRECT_URI=

# ── mcp ──────────────────────────────────────────────────────────────────────
MCP_PUBLIC_URL=https://mcp.staging.sandwormlab.xyz/mcp
AUTH_SERVER_URL=https://app.staging.sandwormlab.xyz
WEB_URL=https://app.staging.sandwormlab.xyz
LOG_TOOL_CALLS=

# ── ai ───────────────────────────────────────────────────────────────────────
AI_OPENROUTER_BASE_URL=
OPENROUTER_EMBEDDING_KEY=
