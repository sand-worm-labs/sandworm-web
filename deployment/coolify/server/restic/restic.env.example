# Copy to /etc/sandworm/restic.env on the server and `chmod 600` it.
# Never commit the filled-in file.

# Where backups go: any S3-compatible bucket (Backblaze B2, Cloudflare R2, AWS S3).
#   B2:  s3:https://s3.<region>.backblazeb2.com/<bucket>/<server-name>
#   R2:  s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>/<server-name>
#   S3:  s3:https://s3.<region>.amazonaws.com/<bucket>/<server-name>
RESTIC_REPOSITORY=

# The repository's encryption password, in a file only root can read
# (`openssl rand -base64 48 > /etc/sandworm/restic.password; chmod 600 ...`).
# Keep a copy in your password manager: without it the backups can't be read.
RESTIC_PASSWORD_FILE=/etc/sandworm/restic.password

# Bucket credentials (B2 and R2 use these names too).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# How many snapshots to keep.
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Optional: an Uptime Kuma Push monitor URL, called after each good backup.
BACKUP_PING_URL=
