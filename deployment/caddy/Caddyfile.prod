# ─── Landing ─────────────────────────────────────────────────────────────────
sandwormlab.xyz, www.sandwormlab.xyz {
	reverse_proxy host.docker.internal:4321
}

# ─── App ─────────────────────────────────────────────────────────────────────
app.sandwormlab.xyz {
	# SSE — flush immediately for streaming AI responses
	@sse path /api/chat*
	handle @sse {
		reverse_proxy host.docker.internal:8003 {
			flush_interval -1
			transport http {
				read_timeout  1h
				write_timeout 1h
			}
		}
	}

	# Socket.IO
	@socketio path /socket.io/*
	handle @socketio {
		reverse_proxy host.docker.internal:8003 {
			transport http {
				read_timeout  24h
				write_timeout 24h
			}
		}
	}

	# YJS WebSocket
	@yjs path /yjs*
	handle @yjs {
		reverse_proxy host.docker.internal:8005 {
			transport http {
				read_timeout  24h
				write_timeout 24h
			}
		}
	}

	# OAuth discovery (RFC 8414) for the MCP server: must live at the root, outside /api
	handle /.well-known/oauth-authorization-server {
		reverse_proxy host.docker.internal:8003
	}

	# MCP clients that can't read the metadata above fall back to these default
	# paths on the issuer (MCP spec), so map them onto the real endpoints
	@oauth_defaults path /authorize /token /register
	handle @oauth_defaults {
		rewrite * /api/oauth{path}
		reverse_proxy host.docker.internal:8003
	}

	# REST API
	handle /api/* {
		reverse_proxy host.docker.internal:8003
	}

	# Next.js — catch-all
	handle {
		reverse_proxy host.docker.internal:3000
	}
}
