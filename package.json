    "@types/http-proxy": "^1.17.17",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "7.12.0",
    "@typescript-eslint/parser": "^8.47.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
